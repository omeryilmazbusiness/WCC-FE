NEXT_PUBLIC_APP_NAME=WODI Command Center
NEXT_PUBLIC_APP_SHORT_NAME=WCC
# Browser code uses same-origin /api/proxy. This is the BFF fallback / server default.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1

# Demo mode (default: false). When "true" — and ONLY when the backend is unreachable
# (network error / proxy 503 upstream_unavailable) — read operations fall back to the
# in-memory demo repositories and login issues a demo session. Writes and every HTTP
# error (401/403/409/422/423/5xx) always surface as a typed ApiError. Never enable in
# production.
NEXT_PUBLIC_DEMO_MODE=false

# Empty disables Sentry. Browser + server SDKs share this DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Optional. Defaults to NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional release label, e.g. wcc-fe@gitsha. Required for source-map upload: SENTRY_AUTH_TOKEN.
NEXT_PUBLIC_SENTRY_RELEASE=

# --- Server-only (BFF) — never prefixed with NEXT_PUBLIC_ ---
# HMAC key for the signed `wcc_session` cookie. Required (>= 32 chars) in production.
SESSION_SECRET=
# Backend base URL used by the BFF route handlers / server components.
# Defaults to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=http://localhost:8080/v1
# Cookies are Secure in production by default; set "false" only for plain-HTTP local prod runs.
COOKIE_SECURE=
# Refresh-token / session cookie lifetime in seconds (default 7 days).
SESSION_MAX_AGE_SECONDS=604800
# Extra comma-separated origins accepted by the CSRF Origin check (the app's own origin is always allowed).
BFF_ALLOWED_ORIGINS=
