    "test:query-cache": "node --experimental-strip-types scripts/selftest-query-cache.ts",
    "test:typewriter": "node --experimental-strip-types scripts/selftest-typewriter.ts",
    "test:flights": "node --experimental-strip-types scripts/selftest-flights.ts",
    "test:customers": "node --experimental-strip-types scripts/selftest-customer-profile.ts",
    "test:tasks": "node --experimental-strip-types scripts/selftest-tasks.ts",
    "test:notifications": "node --experimental-strip-types scripts/selftest-notifications.ts",
    "test:packages": "node --experimental-strip-types scripts/selftest-packages.ts",
    "test:package-links": "node --experimental-strip-types scripts/selftest-package-links.ts",
    "test:bookings": "node --experimental-strip-types scripts/selftest-bookings.ts",
    "test:hotels": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/selftest-hotels.ts",
    "test:suppliers": "node --experimental-transform-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/selftest-suppliers.ts",
    "test:finance": "node --experimental-transform-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/selftest-finance.ts",
