{
  "name": "wcc-fe",
  "version": "0.1.0",
  "private": true,
  "description": "WODI Command Center Frontend (WCC-FE)",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "dev:webpack": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:i18n": "node scripts/check-i18n-keys.mjs",
    "test:settings": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve.mjs scripts/selftest-settings.ts",
